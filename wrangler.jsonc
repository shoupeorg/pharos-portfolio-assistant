{
	"name": "pharos-portfolio-assistant",
	"main": "worker.js",
	"compatibility_date": "2026-10-18",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pharos-portfolio-assistant",
			"database_id": "fff4fe9e-8f7f-42a4-8b68-c376289a9364",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}